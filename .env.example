# Comma-separated origins allowed to call the API routes.
ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:3000

# AdBlueMedia offer feed. Defaults to the official feed and the public offers
# key; replace with your own AdBlueMedia credentials for production.
# Feed: https://d3r33tlb373kwk.cloudfront.net/public/offers/feed.php
OFFER_FEED_URL=
OFFER_FEED_USER_ID=
OFFER_FEED_API_KEY=
